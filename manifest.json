{
  "manifest_version": 3,
  "name": "SkyDropX Quote Form Tweaks",
  "author": "Jesus Enrique Franco Martinez",
  "version": "0.1.50",
  "description": "Runs accesibility helpers when visiting forms",
  
  "permissions": [
    "activeTab"
  ],
  
  "content_scripts": [
    {
      "matches": ["https://app.skydropx.com/*"],
      "js": [
        "playwright-like.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
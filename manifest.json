{
  "manifest_version": 3,
  "name": "SkyDropX Quote Form Tweaks",
  "author": "Jesus Enrique Franco Martinez",
  "version": "0.1.51",
  "description": "Runs accesibility helpers when visiting forms",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  
  "permissions": [
    "activeTab", "tabs"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://app.skydropx.com/*"],
      "js": [
        "lib/playwright-like.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}